use v6.d;
use lib 'lib';
use lib 'specs/lib';
use Test;
use ORM::ActiveRecord::DB;
use ORM::ActiveRecord::Instrumentation::Notifications;
use Models::Page;
use Models::User;

plan 14;

%*ENV<DISABLE-SQL-LOG> = True;

sub sql-of(&block) {
  my @sql;
  my $sub = Notifications.subscribe('sql.active_record', -> %p { @sql.push: %p<sql> });
  block();
  Notifications.unsubscribe($sub);
  @sql;
}

is  Page.belongs-to-foreign-keys{'user'}, 'user_id',          'belongs-to-foreign-keys maps a plain belongs-to to its conventional column';
is  Page.belongs-to-foreign-keys{'autosave-user'}, 'user_id', 'belongs-to-foreign-keys maps a belongs-to with a foreign-key option to that column';
nok Page.belongs-to-foreign-keys{'nonesuch'}:exists,         'belongs-to-foreign-keys leaves out a name the class does not declare';
is  User.belongs-to-foreign-keys.elems, 0,                   'belongs-to-foreign-keys is empty for a class that declares none';

my $foreign-keys = Page.belongs-to-foreign-keys;
ok Page.belongs-to-foreign-keys === $foreign-keys, 'belongs-to-foreign-keys hands back the same map on a repeated call';

is Page.where({ user => 7 }).where-values{'user_id'}, 7,
  'a belongs-to name is still rewritten to its foreign key in a where clause';

# The belongs-to foreign keys of a class are derived from one instance the first
# time any relation needs them, so warm them before measuring what building a
# relation costs.
Page.belongs-to-foreign-keys;
DB.shared.adapter.clear-schema-cache;

is sql-of({ Page.all }).elems, 0, 'building a relation queries nothing';
is sql-of({ Page.all.where({ id => 1 }) }).elems, 0, 'adding a condition queries nothing';

my $relation = Page.all;
ok sql-of({ $relation.all-fields }).elems > 0, 'naming the fields reads the column list';
is sql-of({ $relation.all-fields }).elems, 0, 'the column list is read only once';

ok Page.all.all-fields.map(*.name).first(* eq 'name').defined,
  'the named fields cover every column of the table';

is Page.all.select('name').fields-of.map(*.name).list, ('name',),
  'the named fields narrow to the selected columns';

my $narrowed = Page.all.select('name');
$narrowed.fields-of;
is $narrowed.select('id').fields-of.map(*.name).sort.list, ('id', 'name'),
  'the named fields renarrow when the selection grows';

is Page.all.select('COUNT(*) AS c').fields-of.elems, Page.all.all-fields.elems,
  'the named fields fall back to every column when the selection names none of them';
