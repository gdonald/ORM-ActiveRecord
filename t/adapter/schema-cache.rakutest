use v6.d;
use lib 'lib';
use Test;
use ORM::ActiveRecord::DB;
use ORM::ActiveRecord::Instrumentation::Notifications;

%*ENV<DISABLE-SQL-LOG> = True;

my $adapter = DB.shared.adapter;
my $has-db  = $adapter.defined && $adapter.is-connected;

# is-schema-change-sql is a pure classifier and needs no live connection, only a
# constructed adapter instance.
if $adapter.defined {
  ok  $adapter.is-schema-change-sql('CREATE TABLE t (id int)'),        'CREATE is a schema change';
  ok  $adapter.is-schema-change-sql('  alter table t add column x int'), 'ALTER is a schema change';
  ok  $adapter.is-schema-change-sql('DROP TABLE t'),                   'DROP is a schema change';
  ok  $adapter.is-schema-change-sql('RENAME TABLE a TO b'),            'RENAME is a schema change';
  nok $adapter.is-schema-change-sql('SELECT * FROM t'),                'SELECT is not a schema change';
  nok $adapter.is-schema-change-sql('INSERT INTO t(id) VALUES (1)'),   'INSERT is not a schema change';
  ok  $adapter.is-schema-change-sql('/* note */ DROP TABLE t'),        'a leading comment does not hide a schema change';

  # A statement is classified once and each test reads the same stripped text,
  # rather than every classifier redoing the substitutions.
  is  $adapter.strip-sql-prefix('/* note */ DROP TABLE t'), 'DROP TABLE t', 'stripping drops a leading comment';
  is  $adapter.strip-sql-prefix('   SELECT 1'), 'SELECT 1',                 'stripping drops leading whitespace';
  is  $adapter.strip-sql-prefix('SELECT 1'), 'SELECT 1',                    'stripping leaves a bare statement alone';
  ok  $adapter.is-write-stripped('INSERT INTO t(id) VALUES (1)'),           'a write is classified from the stripped text';
  nok $adapter.is-write-stripped('SELECT * FROM t'),                        'a read is classified from the stripped text';
  ok  $adapter.is-schema-change-stripped('DROP TABLE t'),                   'a schema change is classified from the stripped text';
  is  $adapter.is-write-stripped($adapter.strip-sql-prefix('  /* tag */ UPDATE t SET a = 1')),
      $adapter.is-write-sql('  /* tag */ UPDATE t SET a = 1'),
      'the stripped classifier agrees with the whole-statement one';
} else {
  skip 'no adapter configured for the is-schema-change-sql classifier', 14;
}

unless $has-db {
  skip 'no reachable database for the configured adapter', 6;
  done-testing;
  exit 0;
}

$adapter.exec('DROP TABLE IF EXISTS sc_widgets');
$adapter.ddl-create-table('sc_widgets', [ name => { :string, limit => 64 } ]);
END { try $adapter.exec('DROP TABLE IF EXISTS sc_widgets') if $has-db }

$adapter.clear-schema-cache;

my @sql;
my $sub = Notifications.subscribe('sql.active_record', -> %p { @sql.push: %p<sql> });

# The first introspection populates the cache.
$adapter.get-fields(table => 'sc_widgets');
my $after-first = @sql.elems;
ok $after-first > 0, 'the first get-fields introspects the database';

# A repeated call is served from the cache with no further query.
$adapter.get-fields(table => 'sc_widgets');
is @sql.elems, $after-first, 'a repeated get-fields is served from the cache and issues no query';

# column-details is memoized independently of get-fields.
@sql = ();
$adapter.column-details(table => 'sc_widgets');
my $after-details = @sql.elems;
ok $after-details > 0, 'the first column-details introspects the database';

$adapter.column-details(table => 'sc_widgets');
is @sql.elems, $after-details, 'a repeated column-details is served from the cache and issues no query';

# A schema change invalidates the cache, so the next call re-introspects.
@sql = ();
$adapter.ddl-add-column('sc_widgets', 'extra' => { :integer });
$adapter.get-fields(table => 'sc_widgets');
ok @sql.elems > 0, 'a schema change invalidates the cache and forces re-introspection';

# And the re-introspected metadata reflects the newly added column.
my @detail-names = $adapter.column-details(table => 'sc_widgets').map(*<name>);
ok @detail-names.first(* eq 'extra').defined, 'the re-introspected column-details include the new column';

Notifications.unsubscribe($sub);

done-testing;
