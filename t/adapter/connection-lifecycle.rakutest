
use v6.d;
use lib 'lib';
use ORM::ActiveRecord::DB;
use Test;

plan 11;

%*ENV<DISABLE-SQL-LOG> = True;

my $db = DB.shared;

# A query at startup forces the lazy connect (BUILD already does it, but be explicit)
$db.exec('SELECT 1');
ok $db.is-connected, 'shared DB is connected after first query';

# Clean shutdown
ok $db.disconnect, 'disconnect returns True when there was a live handle';
nok $db.is-connected, 'is-connected reports false after disconnect';
nok $db.disconnect, 'second disconnect is a no-op and returns False';

# Reconnect path
$db.reconnect;
ok $db.is-connected, 'reconnect restores the connection';

my @rows = $db.exec('SELECT 1');
is @rows[0][0].Int, 1, 'a query succeeds after reconnect';

# Auto-reconnect: after disconnect, the next exec brings the connection back
$db.disconnect;
nok $db.is-connected, 'disconnected before auto-reconnect probe';
my @rows2 = $db.exec('SELECT 2');
is @rows2[0][0].Int, 2, 'exec auto-reconnects when handle is nil';

# close() tears down the primary adapter (and any built pool) deterministically
$db.exec('SELECT 1') unless $db.is-connected;
$db.close;
nok $db.is-connected, 'close disconnects the adapter';

# disconnect-shared closes the live shared connection and clears the registry,
# so the next .shared rebuilds a fresh, working connection
my $shared = DB.shared;
$shared.exec('SELECT 1') unless $shared.is-connected;
DB.disconnect-shared;
nok $shared.is-connected, 'disconnect-shared closed the previous shared connection';

my @rows3 = DB.shared.exec('SELECT 3');
is @rows3[0][0].Int, 3, 'the next .shared rebuilds a working connection';
