
use v6.d;
use lib 'lib';
use Test;
use ORM::ActiveRecord::DB;
use ORM::ActiveRecord::Connection::Pool;

%*ENV<DISABLE-SQL-LOG> = True;

my $adapter = DB.shared.adapter;

unless $adapter.defined && $adapter.is-connected {
  plan 1;
  skip 'no database connection available';
  exit 0;
}

sub new-pool(*%opts --> ConnectionPool) {
  ConnectionPool.new(builder => { DB.shared.build-connection }, |%opts);
}

# adapter health probes
ok DB.shared.is-active, 'is-active is true on a live connection';

my $dead = DB.shared.build-connection;
$dead.disconnect;
ok $dead.verify, 'verify reconnects a disconnected connection';
$dead.disconnect;

# checkout / checkin
{
  my $pool = new-pool(size => 2);
  my $conn = $pool.checkout;
  ok $conn.is-active, 'checkout returns a live connection';
  $pool.checkin($conn);
  is $pool.stats<in-use>, 0, 'checkin returns the connection to the pool';
  $pool.disconnect-all;
}

# reuse rather than grow
{
  my $pool = new-pool(size => 5);
  $pool.checkin($pool.checkout);
  $pool.checkin($pool.checkout);
  is $pool.stats<created>, 1, 'an idle connection is reused rather than growing the pool';
  $pool.disconnect-all;
}

# with-connection
{
  my $pool = new-pool(size => 2);
  is $pool.with-connection(-> $c { $c.exec('SELECT 1'); 42 }), 42,
    'with-connection returns the block result';
  is $pool.stats<in-use>, 0, 'with-connection checks the connection back in';
  $pool.disconnect-all;
}

# size cap + checkout timeout
{
  my $pool = new-pool(size => 1, checkout-timeout => 0.2);
  my $held = $pool.checkout;
  my $second = try { $pool.checkout };
  nok $second.defined, 'checkout times out when the pool is exhausted';
  $pool.disconnect-all;
}

# auto-reconnect on a dropped connection
{
  my $pool = new-pool(size => 1, verify-idle-after => 0);
  my $conn = $pool.checkout;
  $pool.checkin($conn);
  $conn.disconnect;
  my $again = $pool.checkout;
  ok $again.is-active, 'a probed checkout reconnects a connection that died while idle';
  $pool.disconnect-all;
}

# reaping
{
  my $pool = new-pool(size => 2, idle-timeout => 0.01);
  $pool.checkin($pool.checkout);
  sleep 0.05;
  $pool.reap;
  is $pool.stats<created>, 0, 'reap disconnects connections idle past the idle timeout';
  $pool.disconnect-all;
}

# DB.with-connection
{
  my @rows = DB.shared.with-connection(-> $c { $c.exec('SELECT 1') });
  DB.shared.pool.disconnect-all;
  is @rows[0][0].Int, 1, 'DB.with-connection runs a query on a pooled connection';
}

# Building a connection is a TCP connect and an auth handshake. Holding the
# pool lock across it would block every other checkout and checkin, so the slot
# is claimed under the lock and the connection built outside it.
{
  my $pool;
  my $seen-from-another-thread;

  $pool = ConnectionPool.new(
    size    => 2,
    builder => {
      # `stats` takes the pool lock. Reading it from another thread while the
      # builder runs only completes if the lock is free; the bound turns a
      # regression into a failure rather than a hang.
      my $probe = start { $pool.stats<created> };
      await Promise.anyof($probe, Promise.in(2));
      $seen-from-another-thread = $probe.status == Kept ?? $probe.result !! Nil;
      DB.shared.build-connection;
    },
  );

  $pool.checkout;
  is $seen-from-another-thread, 1, 'the pool lock is free while the builder runs';
  $pool.disconnect-all;
}

{
  my $pool = ConnectionPool.new(size => 1, builder => { die 'no connection' });
  try $pool.checkout;
  is $pool.stats<created>, 0, 'a builder that throws releases the claimed slot';
}

{
  my $fail = True;
  my $pool = ConnectionPool.new(
    size    => 1,
    builder => { $fail ?? die 'no connection' !! DB.shared.build-connection },
  );

  try $pool.checkout;
  $fail = False;
  ok $pool.checkout.defined, 'a later checkout tries again after a failed build';
  $pool.disconnect-all;
}

# An exhausted checkout waits on a promise the next checkin keeps, rather than
# re-taking the lock every few milliseconds.
{
  my $pool = new-pool(size => 1, checkout-timeout => 5);
  my $held = $pool.checkout;

  my $waiting = start { $pool.checkout };
  $pool.checkin($held);

  ok (await $waiting).defined, 'a returned connection wakes a waiting checkout';
  $pool.disconnect-all;
}

# verify-idle-after: the checkout health probe is reserved for connections
# that have sat idle past the threshold.

my role ProbeCounter {
  has Int $.probes is rw = 0;
  method is-active(--> Bool) { $!probes++; callsame }
}

sub counting-pool(*%opts --> ConnectionPool) {
  ConnectionPool.new(builder => { DB.shared.build-connection does ProbeCounter }, |%opts);
}

{
  my $pool = counting-pool(size => 1);
  my $conn = $pool.checkout;
  $pool.checkin($conn);
  $pool.checkout;
  is $conn.probes, 0, 'by default a recently used connection checks out without a probe';
  $pool.disconnect-all;
}

{
  my $pool = counting-pool(size => 1, verify-idle-after => 0);
  my $conn = $pool.checkout;
  $pool.checkin($conn);
  $pool.checkout;
  is $conn.probes, 2, 'setting the threshold to zero probes on every checkout';
  $pool.disconnect-all;
}

{
  my $pool = counting-pool(size => 1, verify-idle-after => 60);
  my $conn = $pool.checkout;
  $pool.checkin($conn);
  $pool.checkout;
  is $conn.probes, 0, 'a connection idle less than verify-idle-after checks out without a probe';
  $pool.disconnect-all;
}

{
  my $pool = counting-pool(size => 1, verify-idle-after => 0.01);
  my $conn = $pool.checkout;
  $pool.checkin($conn);
  sleep 0.05;
  $pool.checkout;
  is $conn.probes, 1, 'a connection idle past verify-idle-after is probed on checkout';
  $pool.disconnect-all;
}

# Skipping the probe is safe because the statement layer recovers from a
# connection that dropped since it was last used.
{
  my $pool = new-pool(size => 1);
  my $conn = $pool.checkout;
  $pool.checkin($conn);
  $conn.disconnect;
  my $again = $pool.checkout;
  is $again.exec('SELECT 1')[0][0].Int, 1,
    'a read recovers on a connection handed out without a probe';
  $pool.disconnect-all;
}

done-testing;
