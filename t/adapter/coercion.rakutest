
use v6.d;
use lib 'lib';
use ORM::ActiveRecord::Model;
use Test;

class Contract is Model {
  submethod BUILD { }
}

class Article is Model {
  submethod BUILD { }
}

plan 25;

%*ENV<DISABLE-SQL-LOG> = True;

# Boolean round-trip — write True / False, read back as Bool

Contract.destroy-all;

my $c = Contract.create({ name => 'Round-trip True', terms => True });
ok $c.id, 'contract with terms=True created';

my $found = Contract.find($c.id);
isa-ok $found.attrs<terms>, Bool, 'terms read back as Bool when stored True';
is $found.attrs<terms>, True, 'terms preserved as True';

my $c2 = Contract.create({ name => 'Round-trip False', terms => False });
ok $c2.id, 'contract with terms=False created (False no longer mangled to "")';

my $found2 = Contract.find($c2.id);
isa-ok $found2.attrs<terms>, Bool, 'terms read back as Bool when stored False';
is $found2.attrs<terms>, False, 'terms preserved as False';

# Update path also threads booleans through coerce-write
$c.update({ terms => False });
my $reloaded = Contract.find($c.id);
isa-ok $reloaded.attrs<terms>, Bool, 'updated terms read back as Bool';
is $reloaded.attrs<terms>, False, 'update from True to False persisted';

Contract.destroy-all;

# Timestamp round-trip — Article has created_at/updated_at populated by touch-timestamps

Article.destroy-all;

my $a = Article.create({ title => 'Coercion', body => 'check' });
isa-ok $a.attrs<created_at>, DateTime, 'created_at materialized as DateTime on insert';

my $found-a = Article.find($a.id);
isa-ok $found-a.attrs<created_at>, DateTime, 'created_at read back as DateTime';
isa-ok $found-a.attrs<updated_at>, DateTime, 'updated_at read back as DateTime';
ok $found-a.attrs<created_at>.posix > 0, 'created_at carries a real epoch value';

Article.destroy-all;

# Blank string for a non-text column — a blank form field for a timestamp must
# not reach the driver as "". It becomes the typed null, so touch-timestamps
# fills created_at, while a text column keeps its empty string.

Article.destroy-all;

my $blank = Article.create({ title => 'Blank Date', body => '', created_at => '' });
ok $blank.id, 'a page created with a blank created_at string persists';
isa-ok $blank.attrs<created_at>, DateTime, 'a blank created_at is auto-filled with a DateTime';
is $blank.attrs<body>, '', 'a blank text column keeps its empty string';

my $found-blank = Article.find($blank.id);
isa-ok $found-blank.attrs<created_at>, DateTime, 'the auto-filled created_at reads back as DateTime';

# A blank string for a numeric or boolean column becomes the typed null too, so
# the column falls back to its declared default instead of reaching the driver
# as "".

my $blank-int = Article.create({ title => 'Blank Int', body => 'x', score => '' });
my $found-int = Article.find($blank-int.id);
isa-ok $found-int.attrs<score>, Int, 'a blank integer reads back as Int';
is $found-int.attrs<score>, 0, 'a blank integer stores the column default';

my $blank-bool = Article.create({ title => 'Blank Bool', body => 'x', published => '' });
my $found-bool = Article.find($blank-bool.id);
isa-ok $found-bool.attrs<published>, Bool, 'a blank boolean reads back as Bool';
is $found-bool.attrs<published>, False, 'a blank boolean stores the column default';

# Update path coerces a blank non-text value too: it becomes the typed null, so
# the column is cleared rather than reaching the driver as "".
my $scored = Article.create({ title => 'Scored', body => 'x', score => 7 });
$scored.update({ title => 'Scored Renamed', score => '' });
my $reloaded-scored = Article.find($scored.id);
nok $reloaded-scored.attrs<score>.defined, 'a blank score on update clears the column';
is $reloaded-scored.attrs<title>, 'Scored Renamed', 'the update otherwise applied';

# Blanking a NOT NULL column is a real attempt to write null, so it raises
# rather than passing over the column and discarding the caller's edit.
dies-ok { $blank.update({ created_at => '' }) }, 'a blank NOT NULL column raises rather than being skipped';

Article.destroy-all;

# An explicitly undefined value is not a blank string, so it is left untouched
# rather than being probed with `eq ''` (which would warn on a type object).
my $undef = Article.create({ title => 'Undef Body', body => Str });
ok $undef.id, 'a record created with an undefined text value persists';
nok $undef.attrs<body>.defined, 'the undefined value is left undefined, not coerced';

Article.destroy-all;
