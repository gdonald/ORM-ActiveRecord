use v6.d;
use lib 'lib';
use lib 'specs/lib';
use Models::Post;
use Models::Tag;
use ORM::ActiveRecord::Instrumentation::Notifications;
use Test;

plan 21;

%*ENV<DISABLE-SQL-LOG> = True;

my $post = Post.create({title => 'First'});
ok $post.is-valid, 'post saved';

my $ruby   = Tag.create({name => 'ruby'});
my $raku   = Tag.create({name => 'raku'});
my $orm    = Tag.create({name => 'orm'});

is $post.tags.elems, 0, 'fresh post has no tags';
ok $ruby.posts.elems == 0, 'fresh tag has no posts';

$post.add-tag($ruby);
$post.add-tag($raku);

my @tags = $post.tags;
is @tags.elems, 2, 'two tags after two adds';
ok @tags.map(*.id).sort.list eqv ($ruby.id, $raku.id).sort.list, 'add-tag links the right rows';

ok $ruby.posts.first.id == $post.id, 'inverse side returns the owning post';

$post.add-tag($orm);
is $post.tags.elems, 3, 'add-tag is additive';

$post.remove-tag($raku);
my @after-remove = $post.tags;
is @after-remove.elems, 2, 'remove-tag drops a single link row';
ok @after-remove.map(*.id).sort.list eqv ($ruby.id, $orm.id).sort.list, 'remove-tag drops the right row';

$post.clear-tags;
is $post.tags.elems, 0, 'clear-tags removes all link rows';
is $ruby.posts.elems, 0, 'clear-tags is visible from the inverse side too';

# inverse-side writes should work the same
$raku.add-post($post);
is $raku.posts.first.id, $post.id, 'add-post from the inverse side links the row';
is $post.tags.first.id,  $raku.id, 'and is visible from the owning side';
$raku.clear-posts;
is $post.tags.elems, 0, 'inverse-side clear empties the join table';

Post.destroy-all;
Tag.destroy-all;

# Preloading a habtm association reads the join rows for every owner at once,
# then the targets they name, rather than a query per owner.
sub counted(&block) {
  my @sql;
  my $sub = Notifications.subscribe('sql.active_record', -> %p { @sql.push: %p<sql> });
  block();
  Notifications.unsubscribe($sub);
  @sql;
}

my $ruby-tag = Tag.create({name => 'ruby'});
my $raku-tag = Tag.create({name => 'raku'});
my $perl-tag = Tag.create({name => 'perl'});

my $first  = Post.create({title => 'First'});
my $second = Post.create({title => 'Second'});
my $third  = Post.create({title => 'Third'});

$first.add-tag($ruby-tag);
$first.add-tag($raku-tag);
$second.add-tag($perl-tag);

my @preloaded = Post.includes('tags').order('id').all;

is @preloaded[0].tags.map(*.name).sort.list, ('raku', 'ruby'), 'preloading gives each owner its own tags';
is @preloaded[1].tags.map(*.name).list, ('perl',),             'preloading gives a second owner its own tags';
is @preloaded[2].tags.elems, 0,                                'preloading gives an owner with no tags an empty collection';

is counted({ Post.includes('tags').order('id').all }).elems, 3,
  'preloading reads the owners, their join rows, and their tags in three queries';

Post.create({title => 'Fourth'}).add-tag(Tag.create({name => 'zig'}));
is counted({ Post.includes('tags').order('id').all }).elems, 3,
  'another owner joining the load adds no query';

is counted({ .tags.elems for @preloaded }).elems, 0,
  'the preloaded tags are served without another query';

my @preloaded-tags = Tag.includes('posts').order('id').all;
is @preloaded-tags[0].posts.map(*.title).list, ('First',), 'the inverse side preloads too';

.clear-tags for Post.all.all;

Post.destroy-all;
Tag.destroy-all;
