
# Documents the empirical fact that Raku rejects both trailing `!` and `?`
# in method-name identifiers. The parser fails with "Missing block" at the
# suffix character. This is the basis for our Raku-idiomatic API choices,
# mapping the conventional punctuated names to their Raku forms:
#   save!     →  save-bang
#   update!   →  update-bang
#   create!   →  create-bang
#   exists?   →  exists  (bare)
#   valid?    →  is-valid

use v6.d;
use Test;
plan 2;

# Confirm the kebab-case + -bang / is- conventions actually compile.
class D {
  method save-bang { 'ok' }
  method is-valid    { True  }
}

ok D.new.save-bang eq 'ok', '-bang suffix compiles and runs';
ok D.new.is-valid,            'is- prefix compiles and runs';
