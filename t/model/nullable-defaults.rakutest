use v6.d;
use lib 'lib';
use lib 'specs/lib';
use ORM::ActiveRecord::Model;
use ORM::ActiveRecord::Errors::X;
use Defaults::NullableColumns;
use Test;

plan 21;

%*ENV<DISABLE-SQL-LOG> = True;

my $ward = Ward.build({ name => 'Ada', slot => 1, code => 'W1' });
nok $ward.score.defined, 'a nullable integer column starts undefined on a new record';

$ward.save;
my $loaded = Ward.find($ward.id);

nok $loaded.score.defined, 'a nullable integer column stores NULL';
nok $loaded.nickname.defined, 'a nullable string column stores NULL';
nok $loaded.guardian_id.defined, 'a nullable foreign key with a constraint stores NULL';
is $loaded.tier, 3, 'a column with a database default gets the database default';

ok $ward.is-persisted, 'a nullable foreign key with a constraint saves without a guardian';

my $guardian = Guardian.create({ name => 'Bea' });
my $guarded = Ward.create({ name => 'Cal', slot => 1, code => 'W1', guardian_id => $guardian.id });
is Ward.find($guarded.id).guardian_id, $guardian.id, 'a nullable foreign key set by the caller stores the guardian';

my $unslotted = Ward.build({ name => 'Dee', code => 'W1' });
is $unslotted.tier, 3, 'a column with a database default starts at the database default on a new record';
nok $unslotted.slot.defined, 'a NOT NULL integer column with no default starts undefined on a new record';

my $count-before = Ward.count;
nok $unslotted.save, 'a NOT NULL integer column with no default is refused by save';
ok $unslotted.errors.is-added('slot', 'blank'), 'a NOT NULL integer column with no default adds a blank error to the column';
is Ward.count, $count-before, 'a NOT NULL integer column with no default stores no row';
nok $unslotted.save(:!validate), 'a NOT NULL integer column with no default is refused by save without validation';
throws-like { $unslotted.save-bang }, X::RecordInvalid, 'a NOT NULL integer column with no default raises X::RecordInvalid from save-bang';

my $uncoded = Ward.build({ name => 'Dee', slot => 1 });
nok $uncoded.code.defined, 'a NOT NULL string column with no default starts undefined on a new record';
nok $uncoded.save, 'a NOT NULL string column with no default is refused by save';

my $cleared = Ward.create({ name => 'Fay', slot => 1, code => 'W1' });
$cleared.slot = Nil;
nok $cleared.save, 'a NOT NULL column cleared on a saved record is refused by save';
is Ward.find($cleared.id).slot, 1, 'a NOT NULL column cleared on a saved record keeps the stored value';

my $changed = Ward.build({ name => 'Eve', slot => 1, code => 'W1' });
$changed.score = 7;
nok $changed.attribute-change('score')[0].defined, 'dirty tracking on a new record reports the change from undefined';

my $reloaded = Ward.find($ward.id);
ok $reloaded == $ward, 'comparing records with == matches a reload whose nullable column is NULL';

$reloaded.score = 7;
nok $ward == $reloaded, 'comparing records with == does not match when the other record has a value in that column';

Ward.destroy-all;
Guardian.destroy-all;
