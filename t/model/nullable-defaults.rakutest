use v6.d;
use lib 'lib';
use lib 'specs/lib';
use ORM::ActiveRecord::Model;
use Defaults::NullableColumns;
use Test;

plan 13;

%*ENV<DISABLE-SQL-LOG> = True;

my $ward = Ward.build({ name => 'Ada', slot => 1 });
nok $ward.score.defined, 'a nullable integer column starts undefined on a new record';

$ward.save;
my $loaded = Ward.find($ward.id);

nok $loaded.score.defined, 'a nullable integer column stores NULL';
nok $loaded.nickname.defined, 'a nullable string column stores NULL';
nok $loaded.guardian_id.defined, 'a nullable foreign key with a constraint stores NULL';
is $loaded.tier, 3, 'a column with a database default gets the database default';

ok $ward.is-persisted, 'a nullable foreign key with a constraint saves without a guardian';

my $guardian = Guardian.create({ name => 'Bea' });
my $guarded = Ward.create({ name => 'Cal', slot => 1, guardian_id => $guardian.id });
is Ward.find($guarded.id).guardian_id, $guardian.id, 'a nullable foreign key set by the caller stores the guardian';

my $unslotted = Ward.build({ name => 'Dee' });
is $unslotted.tier, 3, 'a column with a database default starts at the database default on a new record';
is $unslotted.slot, 0, 'a NOT NULL column with no default starts at the value for its type';

$unslotted.save;
is Ward.find($unslotted.id).slot, 0, 'a NOT NULL column with no default stores the value for its type';

my $changed = Ward.build({ name => 'Eve', slot => 1 });
$changed.score = 7;
nok $changed.attribute-change('score')[0].defined, 'dirty tracking on a new record reports the change from undefined';

my $reloaded = Ward.find($ward.id);
ok $reloaded == $ward, 'comparing records with == matches a reload whose nullable column is NULL';

$reloaded.score = 7;
nok $ward == $reloaded, 'comparing records with == does not match when the other record has a value in that column';

Ward.destroy-all;
Guardian.destroy-all;
